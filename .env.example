# ==============================================================================
# SALALAKART ZONE — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Choose your preferred backend: Google Firebase OR Supabase
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE FIREBASE CONFIGURATION (Firebase Console -> Project Settings -> General -> Web App)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (Supabase Dashboard -> Project Settings -> API)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Or publishable key:
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: Default Administrator Email identifier (if using offline/pre-seeded mode)
# VITE_ADMIN_EMAIL=admin@salalakartzone.com

# ------------------------------------------------------------------------------
# 3. PAYMENT & GENERAL SETTINGS
# ------------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
VITE_SITE_URL=http://localhost:5173

