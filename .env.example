# ==============================================================================
# SALALAKART ZONE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Choose your preferred backend: Supabase (Recommended) OR Google Firebase
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Supabase Dashboard -> Project Settings -> API)
# ------------------------------------------------------------------------------
# Project URL (e.g., https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public / Anon / Publishable Key
# Supports both legacy JWT anon key (eyJ...) and new publishable key format (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key-here

# ------------------------------------------------------------------------------
# CRITICAL SECURITY WARNING: SUPABASE SECRET KEYS
# ------------------------------------------------------------------------------
# NEVER put your Supabase Secret Key (sb_secret_... or service_role JWT) in this file,
# in any client-side .env file, or in any VITE_* variable.
# Variables prefixed with VITE_* are bundled directly into public browser JavaScript.
# Secret Keys must ONLY be used in secure server environments or backend functions.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 2. SINGLE AUTHORIZED ADMINISTRATOR ACCOUNT (SALALAKART ZONE)
# ------------------------------------------------------------------------------
# Only this single authorized administrator account can enter the admin dashboard.
# No other account (including customer accounts) will be granted admin access.
VITE_ADMIN_EMAIL=admin@salalakartzone.com

# Optional: Supabase Auth UUID of the authorized administrator account.
# If specified, the authenticated user's Supabase UUID must match this value exactly.
# VITE_ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------------------------
# 3. GOOGLE FIREBASE CONFIGURATION (Optional Alternative)
# ------------------------------------------------------------------------------
# VITE_FIREBASE_API_KEY=your-firebase-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890

# ------------------------------------------------------------------------------
# 4. PAYMENT & GENERAL SETTINGS
# ------------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
VITE_SITE_URL=http://localhost:5173
